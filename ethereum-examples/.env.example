# Ethereum RPC adapter endpoint (not the validator's native RPC port).
ETH_RPC_URL=http://127.0.0.1:8545
ETH_CHAIN_ID=1337

# Ethereum ECDSA private key: 0x followed by 64 hex characters.
# Run npm run wallet to generate a new .env, or supply a funded Ethereum key here.
PRIVATE_KEY=

# Set this to the contract address printed by npm run demo for later read/set calls.
CONTRACT_ADDRESS=

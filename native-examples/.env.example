# Native node WebSocket RPC (not the Ethereum adapter's port 8545).
NATIVE_RPC_URL=ws://127.0.0.1:9945

# sr25519 mnemonic, secret seed, or secret URI for the funded native account.
# Run npm run wallet to generate a new .env, or set your own account here.
NATIVE_SURI=

# Address printed by npm run demo, used by npm run read and npm run set.
CONTRACT_ADDRESS=

# Optional public native SS58 account used as the origin of read-only calls.
# Defaults to the account derived from NATIVE_SURI if that is configured.
READ_ORIGIN=
